#include <SimpleWebSerial.h>


// WebSerial can be any variable name you want.
SimpleWebSerial WebSerial;






uint8_t BTN_PIN[4]= {4,2,5,6};
bool lastState[4]= {1,1,1,1};






void setup(){
 Serial.begin(9600);


 for (int i=0; i<4;i++){
   pinMode(BTN_PIN[i], INPUT_PULLUP);
 }
}
void loop(){
for (int i=0; i<4;i++){
 int valor = digitalRead(BTN_PIN[i]);
 if (valor == LOW && lastState[i]==HIGH){
   WebSerial.send("boto", i);
 }
 lastState[i]= valor;
}


delay(150);
}
